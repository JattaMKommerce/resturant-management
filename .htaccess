# ======================================================================
# Hostinger CloudLinux / Phusion Passenger Node.js Configuration
# ======================================================================
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/u605028047/domains/springgreen-gorilla-821094.hostingersite.com/public_html/backend"
PassengerBaseURI "/"
PassengerNodejs "/opt/alt/alt-nodejs22/root/usr/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reverse Proxy API, Health, Sockets, and Uploads to Node.js backend
  RewriteCond %{REQUEST_URI} ^/(api|health|socket\.io|uploads) [NC]
  RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L]

  # 2. If static files exist in dist or frontend/dist, serve directly
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -d
  RewriteRule ^(.*)$ frontend/dist/$1 [L]

  # 3. SPA Fallback: Route all unmatched frontend routes to React index.html
  RewriteCond %{REQUEST_URI} !^/(api|health|socket\.io|uploads) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . /dist/index.html [L]

  RewriteCond %{REQUEST_URI} !^/(api|health|socket\.io|uploads) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
  RewriteRule . /frontend/dist/index.html [L]
</IfModule>
