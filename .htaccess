# ======================================================================
# Hostinger CloudLinux / Phusion Passenger Node.js Configuration
# ======================================================================
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/u605028047/domains/springgreen-gorilla-821094.hostingersite.com/public_html/backend"
PassengerBaseURI "/"
PassengerNodejs "/opt/alt/alt-nodejs22/root/usr/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reverse Proxy API, Health, Sockets, and Uploads to Node.js backend
  RewriteCond %{REQUEST_URI} ^/(api|health|socket\.io|uploads) [NC]
  RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L]

  # 2. Serve static assets directly from hotel subfolder
  RewriteCond %{DOCUMENT_ROOT}/hotel/$1 -f
  RewriteRule ^(.*)$ hotel/$1 [L]

  # 3. Clean Professional SPA Routes: /restaurant/*, /admin/*, /order/*, /waiter/*, /kitchen/*, /driver/*
  # Internally serve the React app while keeping the short, professional URL in the browser!
  RewriteCond %{REQUEST_URI} ^/(restaurant|admin|order|waiter|kitchen|driver|rider) [NC]
  RewriteCond %{DOCUMENT_ROOT}/hotel/index.html -f
  RewriteRule ^.*$ /hotel/index.html [L]

  # 4. Fallback for /hotel/* subpath
  RewriteCond %{REQUEST_URI} ^/hotel/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/hotel/index.html -f
  RewriteRule ^hotel/.*$ /hotel/index.html [L]
</IfModule>
