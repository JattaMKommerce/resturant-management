# ======================================================================
# Hostinger Web App - Node.js serves everything directly
# ======================================================================
# No Passenger config needed - Web App platform manages Node.js runtime
# No proxy rules needed - Frontend calls Web App API directly via CORS

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization header
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  <IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  </IfModule>

  # Serve static files directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do NOT rewrite API, Health, Socket.IO, or Uploads to index.html - pass directly to Node.js backend
  RewriteCond %{REQUEST_URI} ^/(api|health|socket\.io|uploads) [NC]
  RewriteRule ^ - [L]

  # SPA Fallback - let frontend routing work for page navigation
  RewriteRule ^ /index.html [L]
</IfModule>
