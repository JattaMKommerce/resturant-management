# ═══════════════════════════════════════════════════════════════════
# HOTEL & RESTAURANT MANAGEMENT SYSTEM (HMS) - BACKEND ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Railway automatically sets PORT; defaults to 5000)
PORT=5000

# Client Application URL (For CORS & Cookie validation - e.g. https://your-app.vercel.app)
# Supports comma-separated list of origins for multi-domain support
FRONTEND_URL=http://localhost:5173,https://resturant-management-pied.vercel.app

# API Public Base URL (optional override)
API_BASE_URL=http://localhost:5000/api/v1

# ───────────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (Managed Cloud MySQL)
# ───────────────────────────────────────────────────────────────────
# Standard Individual Variables
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_db
DB_USER=root
DB_PASSWORD=your_secure_db_password

# Connection Pool & Security Options
DB_CONNECTION_LIMIT=15
DB_SSL=true

# Unified Database URL (e.g. Railway MySQL: mysql://user:pass@host:port/dbname)
# If set, takes precedence over individual DB_* variables
DATABASE_URL=

# ───────────────────────────────────────────────────────────────────
# 2. AUTHENTICATION & SECURITY
# ───────────────────────────────────────────────────────────────────
# Secret key used for signing JWT tokens (Minimum 32 random characters in production)
JWT_SECRET=replace_with_a_very_long_secure_random_jwt_secret_key_minimum_32_chars

# JWT token expiration time (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Cookie Security (Set to 'true' in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ───────────────────────────────────────────────────────────────────
# 3. RAZORPAY PAYMENT GATEWAY
# ───────────────────────────────────────────────────────────────────
# Razorpay Key ID (Public merchant identifier)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# Razorpay Key Secret (Private merchant secret - NEVER EXPOSE TO CLIENT)
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere

# Set to 'true' for local development mock payments without hitting Razorpay servers
RAZORPAY_MOCK_MODE=false

# ───────────────────────────────────────────────────────────────────
# 4. FILE STORAGE (Local vs S3-Compatible Cloud Storage)
# ───────────────────────────────────────────────────────────────────
# Storage Provider: 'local' (development disk) or 's3' (AWS S3, Cloudflare R2, Wasabi, MinIO)
UPLOAD_STORAGE_PROVIDER=local

# S3 / Cloudflare R2 Configuration (Required only when UPLOAD_STORAGE_PROVIDER=s3)
UPLOAD_BUCKET=
UPLOAD_REGION=auto
UPLOAD_ACCESS_KEY=
UPLOAD_SECRET_KEY=
# S3 Endpoint (e.g. https://<account_id>.r2.cloudflarestorage.com for Cloudflare R2)
UPLOAD_ENDPOINT=
# Public CDN URL for serving uploaded images (e.g. https://cdn.yourdomain.com)
UPLOAD_PUBLIC_BASE_URL=

# ───────────────────────────────────────────────────────────────────
# 5. EXTERNAL APIS & INTEGRATIONS
# ───────────────────────────────────────────────────────────────────
# Google Maps API Key (For distance calculation & live routing)
GOOGLE_MAPS_API_KEY=
