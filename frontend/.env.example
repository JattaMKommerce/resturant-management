# ═══════════════════════════════════════════════════════════════════
# HOTEL & RESTAURANT MANAGEMENT SYSTEM (HMS) - FRONTEND ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════
# Note: Vite only exposes variables prefixed with VITE_ to the browser.
# NEVER put private keys, database passwords, or JWT secrets in this file.

# 1. Backend REST API Base URL
# Local Development: http://localhost:5000/api/v1
# Production (Railway): https://your-backend.railway.app/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# 2. Backend Socket.IO WebSocket Server URL
# Local Development: http://localhost:5000
# Production (Railway): https://your-backend.railway.app
VITE_SOCKET_URL=http://localhost:5000

# 3. Razorpay Public Merchant Key (Client-Safe Key ID)
# Format: rzp_test_... or rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_mockkey123456

# 4. Google Maps API Key (Optional for map render & location pickers)
VITE_GOOGLE_MAPS_API_KEY=
